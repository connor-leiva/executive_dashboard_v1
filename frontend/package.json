{
  "name": "spring-command-center-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:intranet": "vite --config vite.intranet.config.js",
    "build": "npm run build:dashboard && npm run build:intranet",
    "build:dashboard": "vite build --outDir dist/dashboard",
    "build:intranet": "vite build --config vite.intranet.config.js",
    "preview": "vite preview --outDir dist/dashboard",
    "preview:intranet": "vite preview --config vite.intranet.config.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
