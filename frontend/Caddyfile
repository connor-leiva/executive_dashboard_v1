:{$PORT:3000} {
  encode zstd gzip

  # AXCION'S OWN HOSTS FIRST. Every other host that reaches this service is a workspace
  # ({slug}.axcion.io, or a customer's own domain), and the catch-all `handle` at the bottom
  # serves it the dashboard. These are pulled out ahead of it.
  #
  #   MARKETING_HOST      serves the marketing site
  #   MARKETING_ALT_HOST  308s to MARKETING_HOST — one canonical host, not two copies
  #   FRONTDOOR_HOST      serves the same bundle, which renders the workspace finder there
  #
  # WHY www IS THE DEFAULT, NOT THE APEX. axcion.io's DNS is at GoDaddy, and GoDaddy cannot point
  # a root domain at Railway (no ALIAS, ANAME or CNAME flattening; Railway's own domain docs list
  # it as unsupported). So today only www can reach this service, and an apex-first default would
  # redirect www to a host that does not serve the site. Once the apex is live here (nameservers
  # moved to Cloudflare, `axcion.io` added on this service), swap the two on the web service:
  #   MARKETING_HOST=axcion.io  MARKETING_ALT_HOST=www.axcion.io
  # No rebuild needed beyond the redeploy Railway does for a variable change.
  #
  # These are env placeholders rather than PLATFORM_DOMAIN because Caddy cannot read a Vite build
  # arg, and a wrong value must never be able to serve the dashboard's sign-in at a platform host.
  # A DEFAULT HERE IS LIVE ROUTING whenever its variable is unset, which was the case for the
  # whole life of acumyn.io: Caddy ran on these, so renaming one dropped www to the dashboard
  # catch-all and took the operator console off admin. on the next deploy for any reason. All
  # four are set explicitly on the `web` service now, at the Phase 9 cutover, and these
  # defaults follow them. MARKETING_ALT_HOST is www.acumyn.io during the retirement window so
  # every old marketing and legal link 308s to its new address instead of dying.
  #
  # ORDER, checked with `caddy adapt` (2.8.4) rather than assumed: this host handle stays ahead of
  # the /intranet/* and /console/* handles below, so these hosts serve only this bundle, and the
  # dashboard's catch-all still sorts last. Verified by request, not just by parse: www and app
  # serve this site, the alt host 308s with path and query intact, and a workspace host still
  # gets its dashboard, /intranet/ and /console/ — with both the default and the swapped hosts.
  @marketing_alt host {$MARKETING_ALT_HOST:www.acumyn.io}
  redir @marketing_alt https://{$MARKETING_HOST:www.axcion.io}{uri} 308

  # Every host used to serve Spring Command Center's privacy.html and eula.html. They are gone,
  # and anything outside this repo that still links them (an app listing, a bookmark) lands on
  # Axcion's own documents instead of on a sign-in page.
  redir /privacy.html https://{$MARKETING_HOST:www.axcion.io}/privacy 308
  redir /eula.html https://{$MARKETING_HOST:www.axcion.io}/terms 308

  # The operator console: Axcion staff administering workspaces. `admin` is in the API's
  # PLATFORM_HOSTS, so it can never resolve to a workspace, and the console's own bundle means a
  # customer's browser never downloads the screen that suspends customers.
  @operator host {$OPERATOR_HOST:admin.axcion.io}
  handle @operator {
    root * /srv/operator
    try_files {path} /index.html
    file_server
  }

  @marketing host {$MARKETING_HOST:www.axcion.io} {$FRONTDOOR_HOST:app.axcion.io}
  handle @marketing {
    root * /srv/marketing
    try_files {path} /index.html
    file_server
  }

  redir /intranet /intranet/ 308

  handle_path /intranet/* {
    root * /srv/intranet
    try_files {path} /index.html
    file_server
  }

  redir /console /console/ 308

  handle_path /console/* {
    root * /srv/console
    try_files {path} /index.html
    file_server
  }

  handle {
    root * /srv/dashboard
    try_files {path} /index.html
    file_server
  }
}
