# ── Spring Command Center API — environment ──
# Local dev: the defaults in app/config.py already run on SQLite with no setup.
# Copy this to backend/.env only when you need to override something.

# Shared
# Local SQLite (default). For Postgres, a plain postgresql://user:pass@host:5432/db
# works too — the app normalizes it to the +asyncpg / +psycopg drivers.
DATABASE_URL=sqlite+aiosqlite:///./command_center.db
# Single-tenant fallback: resolve unknown Hosts to DEV_TENANT_SLUG. Keep true while
# there is one tenant (Spring); set false for real multitenant + custom domains.
SINGLE_TENANT_FALLBACK=true
APP_SECRET=change-me-64-hex                      # python -c "import secrets;print(secrets.token_hex(32))"
FERNET_KEY=change-me-fernet-key                  # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# api only
PUBLIC_API_BASE=http://localhost:8000
APP_PUBLIC_URL=http://localhost:5173             # where the QBO callback redirects back to

# QuickBooks (api + worker)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=production                               # or sandbox
QBO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/qbo/callback

# Sisu + Follow Up Boss are NOT configured here any more. Both are connected per tenant in
# Settings > Integrations and stored encrypted on the integration row (like GHL/Arive/Stripe),
# because one shared key would sync one customer's data into another's dashboard. Only the
# non-secret API bases remain, as defaults a tenant's integration config can override.
SISU_BASE_URL=https://api.sisu.co/api
FUB_API_BASE=https://api.followupboss.com/v1

# Multi-tenancy. Tenants live at {slug}.PLATFORM_DOMAIN; *.PLATFORM_DOMAIN is admitted through
# CORS by regex so adding a tenant needs no env edit. SINGLE_TENANT_FALLBACK resolves an
# unrecognized host to DEV_TENANT_SLUG and turns ITSELF off once a second tenant exists.
PLATFORM_DOMAIN=acumyn.io
DEV_TENANT_SLUG=springb
SINGLE_TENANT_FALLBACK=true

# worker only
SYNC_INTERVAL_MINUTES=30

# Transactional email (Resend) — api AND worker.
# Blank key = no send: invites, resets and owner invites still return their copy-paste link and
# the Binder digest still logs, which is how local dev and the whole test suite run. Set it on
# BOTH Railway services; on the api alone every invite sends and Binder digests silently do not.
# MAIL_FROM must be an address on a domain VERIFIED IN RESEND. Verifying `mail.acumyn.io`
# does not verify `acumyn.io` — a subdomain is a separate domain to an ESP, and sending
# from the wrong one fails 403 rather than bouncing.
# A sending subdomain does not receive mail, so set MAIL_REPLY_TO to a real inbox — a
# password reset sets no reply-to and its replies would otherwise go nowhere.
RESEND_API_KEY=                                  # re_... from resend.com/api-keys
MAIL_FROM=Acumyn <hello@mail.acumyn.io>
MAIL_REPLY_TO=                                   # a mailbox that RECEIVES; see the note above

# Dashboard assistant (the "Ask" panel). Set your Anthropic API key to enable it;
# it stays server-side and is never sent to the browser. Leave blank to hide the
# Ask button. Model + token budget are optional overrides.
ANTHROPIC_API_KEY=                               # sk-ant-... from console.anthropic.com
ASSISTANT_MODEL=claude-sonnet-5                   # or claude-opus-4-8 for deeper reasoning
ASSISTANT_MAX_TOKENS=1200

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
# REQUIRED ON ANY DEPLOYMENT. Without all four, binder_storage falls back to a
# directory under the system temp dir: uploads succeed, and every SOP document,
# workspace logo and marketing attachment is thrown away on the next deploy,
# silently. Startup refuses to boot rather than let that happen — locally they
# are meant to be empty, and the fallback is the right behaviour on a laptop.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
