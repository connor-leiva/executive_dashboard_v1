{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000",
      "cwd": "backend"
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--host"
      ],
      "port": 4173,
      "url": "http://admin.localhost:4173"
    },
    {
      "name": "web-preview-tenant",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "preview",
        "--",
        "--port",
        "4174",
        "--host"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    },
    {
      "name": "intranet",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:intranet"
      ],
      "port": 5174,
      "url": "http://localhost:5174"
    },
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:console"
      ],
      "port": 5175,
      "url": "http://localhost:5175"
    },
    {
      "name": "console-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "preview:console",
        "--",
        "--port",
        "4181",
        "--host"
      ],
      "port": 4181,
      "url": "http://localhost:4181"
    },
    {
      "name": "intranet-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "preview:intranet",
        "--",
        "--port",
        "4182",
        "--host"
      ],
      "port": 4182,
      "url": "http://localhost:4182"
    }
  ]
}
